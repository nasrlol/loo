version(2);
project_name = "loo";

patterns = {
	"*.c",
	"*.cpp",
	"*.h",
	"*.m",
	"*.bat",
	"*.sh",
	"*.4coder",
	"*.jr",
};

blacklist_patterns = {
	".*",
};

paths = {
	{ "./source/code", .relative = true, .recursive = true, },
	{ "./source/base", .relative = true, .recursive = true, },
	{ "./source/platform", .relative = true, .recursive = true, },
	{ "./source/render", .relative = true, .recursive = true, },
	{ "./source/loo", .relative = true, .recursive = true, },
};

linux_paths = {
	{ "./source/code", .relative = true, .recursive = true, },
	{ "./source/base", .relative = true, .recursive = true, },
	{ "./source/platform", .relative = true, .recursive = true, },
	{ "./source/render", .relative = true, .recursive = true, },
	{ "./source/loo", .relative = true, .recursive = true, },
	{ "./.deps/wayland", .relative = true, .recursive = false, },
	{ "./.deps/vulkan",  .relative = true, .recursive = false, },
	{ "./.deps/X11",     .relative = true, .recursive = false, },
};

load_paths = {
	.win   = paths,
	.linux = linux_paths,
	.mac   = linux_paths,
};

commands = {
	.build = {
		.linux            = "direnv exec . ./build.sh",
		.mac              = "direnv exec . ./build.sh",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
	.run = {
		.linux            = "direnv exec . ./build/loo",
		.mac              = "direnv exec . ./build/loo",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
	.reload = {
		.linux            = "direnv exec . ./reload.sh",
		.mac              = "direnv exec . ./reload.sh",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
};

fkey_command = {
	.F1 = "build",
	.F2 = "run",
	.F3 = "reload",
};