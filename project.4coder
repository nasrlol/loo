version(2);
project_name = "loo";
patterns = {
	"*.c",
	"*.cpp",
	"*.h",
	"*.m",
	"*.bat",
	"*.sh",
	"*.4coder",
	"*.jr",
};

blacklist_patterns = {
	".*",
};

paths = {
	{ .path = "./source/code",     .relative = true, .recursive = true, },
	{ .path = "./source/base",     .relative = true, .recursive = true, },
	{ .path = "./source/platform", .relative = true, .recursive = true, },
	{ .path = "./source/render",   .relative = true, .recursive = true, },
	{ .path = "./source/loo",      .relative = true, .recursive = true, },
};

// NOTE: .path must be named; a positional string is stored as key "0" and load_project ignores it
linux_paths = {
	{ .path = "./source/code",     .relative = true, .recursive = true, },
	{ .path = "./source/base",     .relative = true, .recursive = true, },
	{ .path = "./source/platform", .relative = true, .recursive = true, },
	{ .path = "./source/render",   .relative = true, .recursive = true, },
	{ .path = "./source/loo",      .relative = true, .recursive = true, },
	{ .path = "./.deps/wayland",   .relative = true, .recursive = true, },
	{ .path = "./.deps/vulkan",    .relative = true, .recursive = true, },
	{ .path = "./.deps/X11",       .relative = true, .recursive = true, },
};

load_paths = {
	.win   = paths,
	.linux = linux_paths,
	.mac   = linux_paths,
};

commands = {
	.build = {
		.linux            = "./build.sh",
		.mac              = "./build.sh",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
	.run = {
		.linux            = "build/loo",
		.mac              = "build/loo",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
	.reload = {
		.linux            = "direnv exec . ./reload.sh",
		.mac              = "direnv exec . ./reload.sh",
		.out              = "*compilation*",
		.footer_panel     = false,
		.save_dirty_files = true,
		.cursor_at_end    = true,
	},
};

fkey_command = {
	.F1 = "build",
	.F2 = "run",
	.F3 = "reload",
};