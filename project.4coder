version(2);
project_name = "loo";

patterns = {
 "*.c",
 "*.cpp",
 "*.h",
 "*.m",
 "*.bat",
 "*.sh",
 "*.4coder",
 "*.jr",
 };

 blacklist_patterns = {
 ".*",
 };

 paths = {
 { "./source/code", .relative = true, .recursive = true, },
 { "./source/base", .relative = true, .recursive = true, },
 { "./source/platform", .relative = true, .recursive = true, },
 { "./source/render", .relative = true, .recursive = true, },
 { "./source/loo", .relative = true, .recursive = true, },
 };

 linux_paths = {
 { "./source/code", .relative = true, .recursive = true, },
 { "./source/base", .relative = true, .recursive = true, },
 { "./source/platform", .relative = true, .recursive = true, },
 { "./source/render", .relative = true, .recursive = true, },
 { "./source/loo", .relative = true, .recursive = true, },
 { "/usr/include",        .relative = false, .recursive = false, },
 { "/usr/include/vulkan", .relative = false, .recursive = false, },
 { "/usr/include/X11",    .relative = false, .recursive = false, },
 };

 load_paths = {
 .win   = paths,
 .linux = linux_paths,
 .mac   = linux_paths,
 };

 commands = {
 .build = {
.linux            = "./build.sh",
 .mac              = "./build.sh",
 .out              = "*compilation*",
 .footer_panel     = false,
 .save_dirty_files = true,
 .cursor_at_end    = true,
 },
 .run = {
 .linux            = "./build/loo",
 .mac              = "./build/loo",
 .out              = "*compilation*",
 .footer_panel     = false,
 .save_dirty_files = true,
 .cursor_at_end    = true,
 },
 .reload = {
 .linux            = "./reload.sh",
 .mac              = "./reload.sh",
 .out              = "*compilation*",
 .footer_panel     = false,
 .save_dirty_files = true,
 .cursor_at_end    = true,
 },
 };

 fkey_command = {
 .F1 = "build",
 .F2 = "run",
 .F3 = "reload",
};